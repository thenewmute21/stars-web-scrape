# Append to ~/.ssh/config on the Mac. Replace HostName with the IP printed by provision.sh.
Host ovh-agent
  HostName 203.0.113.10
  User agent
  IdentityFile ~/.ssh/ovh_agent_ed25519
  IdentitiesOnly yes
  UseKeychain yes
  AddKeysToAgent yes
  # Reuse one TCP/SSH session for every ssh/rsync/mutagen/VS Code call -> near-zero connect latency.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 4h
  ServerAliveInterval 30
  ServerAliveCountMax 4
  Compression yes
  # Never forward your Mac's agent to a box that runs autonomous code.
  ForwardAgent no
