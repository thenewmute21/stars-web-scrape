[Unit]
Description=Autonomous agent stack (docker compose)
Requires=docker.service
After=docker.service network-online.target srv-agent.mount
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/agent
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build --remove-orphans
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
