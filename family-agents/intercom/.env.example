# Copy to .env (same folder) and fill in. NEVER commit .env or paste it into a chat.

# --- Model keys -------------------------------------------------------------
# OpenAI project key just for her: platform.openai.com -> Projects -> new project
# -> set a monthly budget limit -> create key. (Skip if she signs into Codex with
# a ChatGPT plan instead.)
OPENAI_API_KEY=

# OpenRouter key just for her: openrouter.ai/settings/keys -> Create key
# -> set a credit limit (e.g. $0 or $5). Free models end in ":free".
OPENROUTER_API_KEY=
# Optional: pin a default free model (see `python openrouter_free.py models`)
OPENROUTER_FREE_MODEL=

# --- Intercom ---------------------------------------------------------------
# Private repo used as the mailbox, e.g. yourname/family-intercom
INTERCOM_REPO=
# Fine-grained GitHub token: only INTERCOM_REPO, permissions Issues: Read and write
GITHUB_TOKEN=
# Only issues opened by these GitHub usernames get executed
ALLOWED_SENDERS=dad-github-username,her-github-username

# Where Codex is allowed to work, and how much it may touch
CODEX_WORKDIR=~/codex-workspace
CODEX_SANDBOX=workspace-write
POLL_SECONDS=60
